def grade(marks):
    grades = {
        "A+": (90, 100),
        "A": (75, 89),
        "B": (60, 74),
        "C": (40, 59),
        "F": (0, 39)
    }
    for g, (low, high) in grades.items():
        if low <= marks <= high:
            return g
    return "Invalid"  # if marks are outside 0–100


def student_grading():
    results = {}
    total_marks = 0

    n = int(input("Enter number of subjects: "))

    for i in range(1, n + 1):
        subject = input(f"Enter subject {i} name: ")
        marks = int(input(f"Enter marks for {subject} (0-100): "))

        results[subject] = grade(marks)
        if 0 <= marks <= 100:
            total_marks += marks

    # Report Card
    print("\n--- Report Card ---")
    for subject, grade_letter in results.items():
        print(f"{subject}: {grade_letter}")

    # Summary
    percentage = total_marks / n
    overall_grade = grade(percentage)

    print("\n--- Summary ---")
    print(f"Total Marks: {total_marks}/{n * 100}")
    pri
